(footprint "LED_PLCC-2_3.5x2.8mm_Nested2214_KA"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Flexible LED site: PLCC-2 (Wuerth WL-SMTW 3528 3.5x2.8mm and ams-OSRAM TOPLED 3.4x3.0mm) land with the Wuerth 2214 land nested inside it on the same polarity, so one site takes either package. Pad per polarity is the union of the OSRAM TOPLED recommendation (1.5x2.6mm, 1.5mm gap), the Wuerth 3528 recommendation (1.25x2.4mm, 1.95mm gap) and the Wuerth 2214 recommendation (0.8x1.0mm, 1.2mm gap). Pin 1 = cathode (silkscreen bar side), pin 2 = anode. Reflow only; reduce the stencil aperture to the 2214 land when the small package is fitted. https://www.we-online.com/components/products/datasheet/150141GS73100.pdf")
	(tags "LED PLCC-2 TOPLED WL-SMTW 2214 flexible")
